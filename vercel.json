{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/health",
      "destination": "/api/sync?health=1"
    },
    {
      "source": "/api/payment-callback",
      "destination": "/api/payment?action=callback"
    }
  ]
}
